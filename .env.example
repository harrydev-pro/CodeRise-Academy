# Public frontend settings only. VITE_ variables are embedded in browser code; never put secrets here.

# Leave VITE_API_BASE_URL unset in Vercel. The default "/api" sends requests through the
# website's own domain (see vercel.json), which keeps login cookies working on iPhone Safari.
VITE_API_BASE_URL=https://coderise-academy-backend667-1.onrender.com

# Local development only: where `npm run dev` forwards /api requests.
VITE_DEV_API_URL=http://localhost:3000
