# Public frontend settings only. VITE_ variables are embedded in browser code.
# Production uses the same-origin /api rewrite in vercel.json; leave the base URL unset.
# Local Vite development prefers this backend when /health/ready succeeds.
VITE_DEV_API_URL=http://localhost:3000
# If the local backend is unavailable, Vite forwards /api to the production backend.
VITE_PRODUCTION_API_URL=https://coderise-academy-backend667-1.onrender.com
